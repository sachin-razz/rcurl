(( $+functions[_rcurl_commands] )) ||
_rcurl_commands() {
    local commands; commands=()
    _describe -t commands 'rcurl commands' commands "$@"
}

if [ "$funcstack[1]" = "_rcurl" ]; then
    _rcurl "$@"
else
    compdef _rcurl rcurl
fi
